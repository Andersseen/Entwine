<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="generator" content="{{ context.site.generator }}">
    <title>{{ context.page.title }}</title>
    <link rel="stylesheet" href="{{ context.assets.stylesheet }}">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <details class="mobile-navigation">
      <summary><span class="project-title">{{ context.site.project }}</span><span class="menu-label">Menu</span></summary>
      <nav aria-label="Mobile documentation">
        <div class="views" role="group" aria-label="Entwine views">
          @for (view of context.views; track view.href) {
            <a href="{{ view.href }}">{{ view.label }}</a>
          }
        </div>
        {{{ context.navigation_html }}}
      </nav>
    </details>
    <div class="layout">
      <aside class="sidebar" aria-label="Project sidebar">
        <a class="brand" href="{{ context.home_href }}">{{ context.site.project }}</a>
        <div class="views" role="group" aria-label="Entwine views">
          @for (view of context.views; track view.href) {
            <a href="{{ view.href }}">{{ view.label }}</a>
          }
        </div>
        <nav aria-label="Documentation">{{{ context.navigation_html }}}</nav>
      </aside>
      <main id="main" tabindex="-1">
        <header>
          <p class="metadata">
            @for (item of context.page.metadata; track item.label) {
              @if (item.is_role) {
                <span class="{{ item.class }}" title="Knowledge role">{{ item.label }}</span>
              } @else {
                <span>{{ item.label }}</span>
              }
            }
          </p>
          @if (context.page.show_title) {
            <h1>{{ context.page.title }}</h1>
          }
        </header>
        @if (context.page.has_headings) {
          <details class="inline-toc">
            <summary>On this page</summary>
            <nav aria-label="Page headings"><ul>
              @for (heading of context.page.headings; track heading.id) {
                <li class="{{ heading.class }}"><a href="{{ heading.href }}">{{ heading.text }}</a></li>
              }
            </ul></nav>
          </details>
        }
        <article>{{{ context.page.body_html }}}</article>
        @if (context.page.has_references) {
          <section class="backlinks" aria-label="References">
            <h2>References</h2>
            @if (context.page.references_collapsible) {
              <details><summary>{{ context.page.references.length }} documents</summary><ul>
                @for (link of context.page.references; track link.href) {
                  <li><a href="{{ link.href }}">{{ link.label }}</a></li>
                }
              </ul></details>
            } @else {
              <ul>
                @for (link of context.page.references; track link.href) {
                  <li><a href="{{ link.href }}">{{ link.label }}</a></li>
                }
              </ul>
            }
          </section>
        }
        @if (context.page.has_backlinks) {
          <section class="backlinks" aria-label="Referenced by">
            <h2>Referenced by</h2>
            @if (context.page.backlinks_collapsible) {
              <details><summary>{{ context.page.backlinks.length }} documents</summary><ul>
                @for (link of context.page.backlinks; track link.href) {
                  <li><a href="{{ link.href }}">{{ link.label }}</a></li>
                }
              </ul></details>
            } @else {
              <ul>
                @for (link of context.page.backlinks; track link.href) {
                  <li><a href="{{ link.href }}">{{ link.label }}</a></li>
                }
              </ul>
            }
          </section>
        }
        @if (context.page.has_source) {
          <p class="source">
            @if (context.page.source.has_url) {
              <a href="{{ context.page.source.url }}">Source: <code>{{ context.page.source.path }}</code></a>
            } @else {
              Source: <code>{{ context.page.source.path }}</code>
            }
          </p>
        }
        <footer>Generated by Entwine · Markdown remains the source of truth.</footer>
      </main>
      <aside class="toc" aria-label="Page outline">
        <nav aria-label="On this page"><h2>On this page</h2><ul>
          @for (heading of context.page.headings; track heading.id) {
            <li class="{{ heading.class }}"><a href="{{ heading.href }}">{{ heading.text }}</a></li>
          }
        </ul></nav>
      </aside>
    </div>
  </body>
</html>
