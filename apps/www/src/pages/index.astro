---
import packageJson from "../../package.json";
const version = packageJson.version;
const repository = "https://github.com/Andersseen/Entwine";
const steps = [
  [
    "init",
    "Scaffold the recommended project knowledge. Questions, not answers.",
  ],
  ["dev", "Read it locally. Rebuilds when Markdown changes."],
  [
    "check",
    "Validate links and metadata, and see which knowledge areas exist.",
  ],
  ["setup", "Automate validation and publishing with your Git provider."],
] as const;
const providers = [
  ["GitHub", "GitHub Pages"],
  ["GitLab", "GitLab Pages"],
  ["Bitbucket", "Provider-native static publishing"],
  ["Any Git", "dist/ on any static host"],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Entwine turns repository Markdown into static documentation, relationships, backlinks, a graph, validation, and structured context."
    />
    <title>Entwine — project knowledge, connected.</title>
    <link rel="canonical" href="https://entwine.andersseen.dev/" />
    <meta
      property="og:title"
      content="Entwine — Project knowledge, connected."
    />
    <meta
      property="og:description"
      content="One source of project knowledge, for humans and agents. Markdown → Docs + Graph + Context."
    />
    <meta property="og:url" content="https://entwine.andersseen.dev/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://entwine.andersseen.dev/logo.png"
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="masthead">
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a>
        <a href="/demo/">Live example</a>
        <a href="#convention">Convention</a>
        <a href="#start">Start here</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero">
        <div class="intro">
          <p class="release">Open source / Experimental {version}</p>
          <h1>
            Project knowledge,
            <br />
            connected.
          </h1>
          <p class="lead">
            Turn the Markdown in your repository into navigable documentation,
            relationships, graphs, backlinks, validation, and structured
            context.
          </p>
          <p class="actions">
            <a class="button" href="#start">
              Get started
            </a>
            <a class="button secondary" href="/demo/">
              Live demo → documentation
            </a>
            <a class="button secondary" href="/demo/__entwine/graph/">
              Graph → relationships
            </a>
            <a class="button secondary" href="/demo/__entwine/knowledge/">
              Knowledge → coverage
            </a>
          </p>
          <p class="promise">
            Both sites are generated by Entwine from plain Markdown. Your
            Markdown remains the source of truth.
          </p>
        </div>
        <div
          class="map"
          aria-label="Markdown files connect into documentation, graph, and context"
        >
          <div class="file root">
            <span>docs/</span>
            <strong>index.md</strong>
            <small>Your project starts here.</small>
          </div>
          <div class="branch">
            <div class="file">
              <span>docs/</span>
              <strong>architecture.md</strong>
              <small>Decisions become connections.</small>
            </div>
            <div class="file">
              <span>docs/specs/</span>
              <strong>search.md</strong>
              <small>Links carry the relationships.</small>
            </div>
          </div>
          <div class="compiler">
            Entwine<span>One knowledge model</span>
          </div>
          <div class="outputs">
            <strong>
              Docs<small>Read &amp; navigate</small>
            </strong>
            <strong>
              Graph<small>Follow connections</small>
            </strong>
            <strong>
              Context<small>Reuse knowledge</small>
            </strong>
          </div>
        </div>
      </section>
      <section class="thesis" id="how">
        <h2>Project knowledge is fragmented.</h2>
        <div>
          <p>
            It is spread across the README, docs, architecture notes, state
            files, decisions, specifications, and agent context. The connections
            between them disappear, and every newcomer, human or agent,
            reconstructs the same facts again.
          </p>
          <p>
            Entwine follows the links you already write and turns the Markdown
            in your repository into one shared model of that knowledge.
          </p>
          <pre
            tabindex="0"
            class="flow"
            aria-label="Markdown becomes a knowledge model that feeds docs, graph, and context"
          ><code>Markdown
   ↓
Knowledge model
   ↓
Docs + Graph + Context</code></pre>
        </div>
      </section>
      <section class="thesis" id="convention">
        <div>
          <h2>A convention for durable project knowledge.</h2>
          <p class="note">
            <strong>Recommended, not required.</strong> Any Markdown still
            works. Custom filenames work too: a <code>type</code> in frontmatter
            is enough.
          </p>
        </div>
        <div>
          <pre class="tree" tabindex="0"><code>docs/
├── index.md          what this is, where things are
├── architecture.md   how it is structured today
├── state.md          what is true right now
├── roadmap.md        what is intended next
├── decisions/        what was decided, and why
└── specs/            what capabilities do</code></pre>
          <p>
            <code>state</code> is current reality; <code>roadmap</code> is
            future intent. Entwine recognizes each by path or metadata and shows
            which areas exist: presence, never a quality score. It complements{" "}
            <code>README.md</code>, <code>AGENTS.md</code>,<code>SKILL.md</code>
            , MCP, and OpenSpec instead of replacing them.
            <a href="/docs/convention/">Read the convention</a>.
          </p>
        </div>
      </section>
      <section class="thesis" id="agents">
        <h2>Humans and agents share one source.</h2>
        <div>
          <p>
            The same Markdown feeds readable documentation with backlinks, a
            project graph, and a Knowledge overview for people, and structured
            context for agents. A tool can ask for the current state or the
            architecture directly instead of guessing which file to open.
          </p>
          <p>
            <code>entwine context --json</code> labels every document with its
            role: architecture, state, roadmap, decision, spec, or other. There
            is no second parser, and no AI inside Entwine.
          </p>
          <p>
            See it in the <a href="/demo/">demo project</a>: its
            <a href="/demo/__entwine/knowledge/">Knowledge overview</a> shows
            what exists, and its <a href="/demo/__entwine/graph/">graph</a>
            shows how it connects.
          </p>
        </div>
      </section>
      <section class="workflow" id="start">
        <div>
          <h2>Start here.</h2>
          <p>
            No account, documentation app, or configuration file.
            <code>entwine build</code> remains available for any custom hosting.
          </p>
          <p>
            Install Entwine {version} from npm, or download a native binary for
            Linux x86_64, macOS arm64/x86_64, or Windows x86_64 from
            <a href={`${repository}/releases`}>GitHub Releases</a>. Verify
            native archives against the release’s SHA256SUMS. Binaries are
            unsigned; Entwine remains pre-1.0.
          </p>
          <dl class="steps">
            {steps.map(([command, description]) => (
              <div>
                <dt>
                  <code>entwine {command}</code>
                </dt>
                <dd>{description}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="terminal">
          <pre><code># Install the native CLI through npm
npm install --global @entwine/cli

# In your own repository
entwine init
entwine dev
entwine check
entwine setup

# Or publish dist/ yourself
entwine build</code></pre>
          <p>Local preview at localhost:4173. Refresh after edits.</p>
        </div>
      </section>
      <section class="commands" id="deployment">
        <h2>Publish where your repository lives.</h2>
        <p class="lead">
          <code>entwine setup</code> generates validation and publishing for
          your Git provider, once. After that, the provider's own pipeline
          publishes. Entwine is not a hosted platform and stores no credentials.
        </p>
        <dl>
          {providers.map(([provider, target]) => (
            <div>
              <dt>{provider}</dt>
              <dd>{target}</dd>
            </div>
          ))}
        </dl>
        <p>
          Documentation changes in a pull request are validated before merge.
          Existing CI is never overwritten, and
          <code>entwine setup --dry-run</code> changes nothing.
          <a href="/docs/deployment/">Deployment details</a>, including
          Bitbucket's one-time steps.
        </p>
      </section>
      <section class="principles">
        <h2>
          Small by design.
          <br />
          Clear at the boundaries.
        </h2>
        <div>
          <h3>Parse once, project many ways</h3>
          <p>
            A Rust engine compiles Markdown into one canonical knowledge model.
            Site, graph, and context all derive from it. The renderer is not the
            knowledge model.
          </p>
          <h3>Repository-native and stack-agnostic</h3>
          <p>
            Your application can use any language or framework. Generated
            documentation is static HTML and CSS, with no Entwine runtime in
            production.
          </p>
          <h3>Predictable, inspectable output</h3>
          <p>
            File-based routes. Stable ordering. Automatically derived backlinks.
            A linked SVG graph. Markdown or JSON context. No AI inference or
            network requests during builds.
          </p>
        </div>
      </section>
      <aside class="experimental">
        <strong>A deliberate first release.</strong>
        <p>
          Entwine {version} is experimental and pre-stable. APIs and the context
          schema may change before 1.0. There is no search, plugin system, or
          interactive graph physics. The Knowledge Convention is an open
          proposal that has to earn adoption, not a standard.
        </p>
      </aside>
    </main>
    <footer>
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <p>Project knowledge, connected.</p>
      <a href={repository}>GitHub</a>
      <a href="/docs/">Documentation</a>
      <a href="/demo/">Example</a>
      <span>MIT licensed</span>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    color: #171717;
    background: #f5f5f5;
    font-synthesis: none;
    --ink: #171717;
    --accent: #404040;
    --line: #d4d4d4;
    --mist: #e5e5e5;
    --connector: #737373;
  }
  * {
    box-sizing: border-box;
  }
  .hero > *,
  .thesis > *,
  .workflow > *,
  .principles > *,
  dl > div > * {
    min-width: 0;
  }
  h1,
  h2,
  p,
  dd {
    overflow-wrap: anywhere;
  }
  body {
    margin: 0;
  }
  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: 3px solid var(--connector);
    outline-offset: 5px;
  }
  p {
    line-height: 1.7;
  }
  code {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .masthead,
  main,
  footer {
    max-width: 1280px;
    margin: auto;
    padding-left: clamp(1.5rem, 5vw, 5rem);
    padding-right: clamp(1.5rem, 5vw, 5rem);
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }
  .wordmark img {
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }
  nav a {
    text-decoration: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 4rem 0 6rem;
  }
  .release {
    font-size: 0.85rem;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    line-height: 1.03;
    letter-spacing: -0.065em;
    font-weight: 650;
    margin: 1.5rem 0;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .lead {
    font-size: 1.16rem;
    max-width: 36rem;
  }
  .button {
    display: inline-block;
    background: var(--accent);
    color: #fafafa;
    text-decoration: none;
    border-radius: 6px;
    padding: 0.9rem 1.3rem;
    margin-top: 0.8rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
  }
  .actions .button {
    margin-top: 0;
  }
  .button.secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--accent);
    padding: calc(0.9rem - 1px) calc(1.3rem - 1px);
  }
  .promise {
    font-size: 0.85rem;
    color: #525252;
  }
  .map {
    position: relative;
    padding: 1.5rem 0;
  }
  .file {
    background: #fafafa;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.2rem;
    box-shadow: 0 6px 0 var(--mist);
    min-width: 0;
  }
  .file span,
  .file small {
    display: block;
    font-size: 0.72rem;
    color: #525252;
  }
  .file strong {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    margin: 0.4rem 0;
    overflow-wrap: anywhere;
  }
  .root {
    width: 65%;
    margin: 0 auto;
  }
  .branch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    position: relative;
  }
  .branch:before {
    content: "";
    position: absolute;
    top: -1.5rem;
    left: 25%;
    width: 50%;
    height: 1.5rem;
    border-top: 2px solid var(--connector);
    border-left: 2px solid var(--connector);
    border-right: 2px solid var(--connector);
  }
  .compiler {
    margin: 2.5rem auto 0;
    width: 65%;
    text-align: center;
    background: var(--ink);
    color: #fafafa;
    padding: 1rem;
    border-radius: 40px;
    position: relative;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .compiler:before {
    content: "";
    position: absolute;
    height: 2.5rem;
    top: -2.5rem;
    left: 50%;
    border-left: 2px solid var(--connector);
  }
  .compiler span {
    display: block;
    font-size: 0.7rem;
    font-weight: 400;
    color: #d4d4d4;
  }
  .outputs {
    display: flex;
    justify-content: space-between;
    text-align: center;
    margin-top: 2rem;
    gap: 0.5rem;
    border-top: 2px solid var(--connector);
    padding-top: 1rem;
  }
  .outputs strong {
    font-size: 1.05rem;
    flex: 1;
  }
  .outputs small {
    display: block;
    font-size: 0.68rem;
    font-weight: 400;
    margin-top: 0.4rem;
  }
  .thesis,
  .workflow,
  .principles {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    padding: 4rem 0;
    border-top: 1px solid var(--line);
  }
  .thesis p:first-child,
  .workflow p:first-of-type {
    margin-top: 0;
  }
  .workflow h2 {
    margin-bottom: 1.5rem;
  }
  .flow,
  .tree {
    background: var(--mist);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow: auto;
    line-height: 1.7;
    font-size: 0.85rem;
  }
  .note {
    border-left: 4px solid var(--connector);
    padding-left: 1rem;
  }
  .steps > div {
    grid-template-columns: 1fr;
    gap: 0.2rem;
    padding: 0.8rem 0;
  }
  .terminal {
    background: var(--mist);
    padding: 1.5rem;
    border-radius: 8px;
    min-width: 0;
  }
  .terminal pre {
    margin: 0;
    overflow: auto;
    line-height: 1.8;
  }
  .terminal p {
    font-size: 0.75rem;
    margin-bottom: 0;
    color: #525252;
  }
  .commands {
    padding: 3rem 0 4rem;
  }
  .commands h2 {
    margin-bottom: 2rem;
  }
  dl > div {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    gap: 2rem;
  }
  dt {
    color: var(--accent);
    font-weight: 600;
  }
  dd {
    margin: 0;
    line-height: 1.5;
  }
  .principles p {
    margin-bottom: 2rem;
  }
  .experimental {
    border-left: 4px solid var(--connector);
    padding: 1rem 2rem;
    background: var(--mist);
    margin: 1rem 0 5rem;
  }
  .experimental p {
    margin-bottom: 0;
    font-size: 0.95rem;
    max-width: 65rem;
  }
  footer {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
    padding-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    font-size: 0.8rem;
  }
  footer p {
    flex: 1;
  }
  .skip {
    position: absolute;
    top: -100px;
    padding: 1rem;
    background: #fafafa;
  }
  .skip:focus {
    top: 0;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2rem;
    }
    .map {
      max-width: 540px;
      width: 100%;
      margin: auto;
    }
    .thesis,
    .workflow,
    .principles {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 0;
    }
    h1 {
      font-size: 4rem;
    }
    footer {
      flex-wrap: wrap;
    }
    footer p {
      flex: auto;
    }
    nav {
      gap: 1rem;
    }
  }
  @media (max-width: 550px) {
    .masthead {
      align-items: center;
      gap: 1rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }
    nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      font-size: 0.8rem;
      gap: 0.5rem 1rem;
    }
    .masthead nav a:nth-child(n + 3) {
      display: none;
    }
    h1 {
      font-size: clamp(2.25rem, 10.5vw, 3rem);
      letter-spacing: -0.055em;
      line-height: 1.08;
      margin: 1rem 0;
    }
    .hero {
      padding-top: 1.25rem;
      padding-bottom: 2rem;
      gap: 1rem;
    }
    .release {
      margin: 0;
      font-size: 0.75rem;
    }
    .lead {
      font-size: 1rem;
    }
    .promise {
      font-size: 0.8rem;
    }
    .map {
      padding: 1rem 0;
    }
    .terminal {
      padding: 1rem;
    }
    .terminal pre {
      font-size: 0.8rem;
    }
    .thesis,
    .workflow,
    .principles {
      padding: 2.5rem 0;
      gap: 1.5rem;
    }
    dl > div {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .file {
      padding: 0.8rem;
    }
    .branch {
      gap: 0.6rem;
    }
    .experimental {
      padding: 1rem;
    }
    .outputs small {
      font-size: 0.62rem;
    }
  }
</style>
