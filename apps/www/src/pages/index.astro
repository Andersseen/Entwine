---
const repository = "https://github.com/Andersseen/Entwine";
const commands = [
  ["dev", "Read your docs locally. Rebuild when Markdown changes."],
  ["build", "Publish plain HTML and CSS to any static host."],
  ["check", "Catch broken links, bad metadata, and route collisions."],
  ["graph", "See documents and their directed relationships."],
  ["context --json", "Export structured knowledge for your own tools."],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Entwine turns repository Markdown into static documentation, relationships, backlinks, a graph, validation, and structured context."
    />
    <title>Entwine — project knowledge, connected.</title>
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="masthead">
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a>
        <a href="/demo/">Live example</a>
        <a href="#try">Try 0.1.0</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero">
        <div class="intro">
          <p class="release">Open source / Experimental 0.1.0</p>
          <h1>
            Project knowledge,
            <br />
            connected.
          </h1>
          <p class="lead">
            Turn the Markdown in your repository into navigable documentation,
            relationships, graphs, backlinks, validation, and structured
            context.
          </p>
          <p class="actions">
            <a class="button" href="/docs/">
              Read the documentation
            </a>
            <a class="button secondary" href="/demo/">
              See a live example
            </a>
            <a class="button secondary" href="/demo/__entwine/graph/">
              Open a project graph
            </a>
          </p>
          <p class="promise">
            Both sites are generated by Entwine from plain Markdown. Your
            Markdown remains the source of truth.
          </p>
        </div>
        <div
          class="map"
          aria-label="Markdown files connect into documentation, graph, and context"
        >
          <div class="file root">
            <span>docs/</span>
            <strong>index.md</strong>
            <small>Your project starts here.</small>
          </div>
          <div class="branch">
            <div class="file">
              <span>docs/</span>
              <strong>architecture.md</strong>
              <small>Decisions become connections.</small>
            </div>
            <div class="file">
              <span>docs/specs/</span>
              <strong>search.md</strong>
              <small>Links carry the relationships.</small>
            </div>
          </div>
          <div class="compiler">
            Entwine<span>One knowledge model</span>
          </div>
          <div class="outputs">
            <strong>
              Docs<small>Read &amp; navigate</small>
            </strong>
            <strong>
              Graph<small>Follow connections</small>
            </strong>
            <strong>
              Context<small>Reuse knowledge</small>
            </strong>
          </div>
        </div>
      </section>
      <section class="thesis" id="how">
        <h2>The knowledge is already there.</h2>
        <div>
          <p>
            Architecture notes. Specifications. Decisions. They live beside your
            code, but the connections disappear between files.
          </p>
          <p>
            Entwine follows the links you already write. It gives each document
            a page, builds navigation from folders, and shows where each page is
            referenced. A normal repository with a <code>docs/</code> directory
            is enough.
          </p>
        </div>
      </section>
      <section class="workflow" id="try">
        <div>
          <h2>
            Try it on
            <br />
            your repository.
          </h2>
          <p>
            Download a prebuilt <code>entwine</code> binary for Linux, macOS, or
            Windows from
            <a href={`${repository}/releases`}>GitHub Releases</a>, or build
            from source with Rust stable. No account, documentation app, or
            configuration file.
          </p>
          <p>
            Every release lists SHA-256 checksums. Packages for npm or Homebrew
            do not exist yet.
          </p>
          <p>
            This site's <a href="/docs/">documentation</a> and the
            <a href="/demo/">example project</a> were compiled by Entwine
            itself.
          </p>
        </div>
        <div class="terminal">
          <pre><code># Download from GitHub Releases, or from a source checkout:
cargo install --path crates/entwine-cli

# In your own repository
mkdir -p docs
printf '# My project\n' > docs/index.md
entwine check
entwine dev

# Publish dist/ to any static host, even below a subpath
entwine build
entwine context --json</code></pre>
          <p>Local preview at localhost:4173. Refresh after edits.</p>
        </div>
      </section>
      <section class="commands">
        <h2>Five commands. One source of truth.</h2>
        <dl>
          {commands.map(([command, description]) => (
            <div>
              <dt>
                <code>entwine {command}</code>
              </dt>
              <dd>{description}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="principles">
        <h2>
          Small by design.
          <br />
          Clear at the boundaries.
        </h2>
        <div>
          <h3>Parse once, project many ways</h3>
          <p>
            A Rust engine compiles Markdown into one canonical knowledge model.
            Site, graph, and context all derive from it. The renderer is not the
            knowledge model.
          </p>
          <h3>Repository-native and stack-agnostic</h3>
          <p>
            Your application can use any language or framework. Generated
            documentation is static HTML and CSS, with no Entwine runtime in
            production.
          </p>
          <h3>Predictable, inspectable output</h3>
          <p>
            File-based routes. Stable ordering. Automatically derived backlinks.
            A linked SVG graph. Markdown or JSON context. No AI inference or
            network requests during builds.
          </p>
        </div>
      </section>
      <aside class="experimental">
        <strong>A deliberate first release.</strong>
        <p>
          Entwine 0.1.0 is experimental and pre-stable. APIs and the context
          schema may change before 1.0. There is no search, plugin system, or
          interactive graph physics. This release makes Entwine easy to inspect,
          download, and try on a real repository.
        </p>
      </aside>
    </main>
    <footer>
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <p>Project knowledge, connected.</p>
      <a href={repository}>GitHub</a>
      <a href="/docs/">Documentation</a>
      <a href="/demo/">Example</a>
      <span>MIT licensed</span>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    color: #171717;
    background: #f5f5f5;
    font-synthesis: none;
    --ink: #171717;
    --accent: #404040;
    --line: #d4d4d4;
    --mist: #e5e5e5;
    --connector: #737373;
  }
  * {
    box-sizing: border-box;
  }
  .hero > *,
  .thesis > *,
  .workflow > *,
  .principles > *,
  dl > div > * {
    min-width: 0;
  }
  h1,
  h2,
  p,
  dd {
    overflow-wrap: anywhere;
  }
  body {
    margin: 0;
  }
  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: 3px solid var(--connector);
    outline-offset: 5px;
  }
  p {
    line-height: 1.7;
  }
  code {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .masthead,
  main,
  footer {
    max-width: 1280px;
    margin: auto;
    padding-left: clamp(1.5rem, 5vw, 5rem);
    padding-right: clamp(1.5rem, 5vw, 5rem);
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }
  .wordmark img {
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }
  nav a {
    text-decoration: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 4rem 0 6rem;
  }
  .release {
    font-size: 0.85rem;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    line-height: 1.03;
    letter-spacing: -0.065em;
    font-weight: 650;
    margin: 1.5rem 0;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .lead {
    font-size: 1.16rem;
    max-width: 36rem;
  }
  .button {
    display: inline-block;
    background: var(--accent);
    color: #fafafa;
    text-decoration: none;
    border-radius: 6px;
    padding: 0.9rem 1.3rem;
    margin-top: 0.8rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
  }
  .actions .button {
    margin-top: 0;
  }
  .button.secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--accent);
    padding: calc(0.9rem - 1px) calc(1.3rem - 1px);
  }
  .promise {
    font-size: 0.85rem;
    color: #525252;
  }
  .map {
    position: relative;
    padding: 1.5rem 0;
  }
  .file {
    background: #fafafa;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.2rem;
    box-shadow: 0 6px 0 var(--mist);
    min-width: 0;
  }
  .file span,
  .file small {
    display: block;
    font-size: 0.72rem;
    color: #525252;
  }
  .file strong {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    margin: 0.4rem 0;
    overflow-wrap: anywhere;
  }
  .root {
    width: 65%;
    margin: 0 auto;
  }
  .branch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    position: relative;
  }
  .branch:before {
    content: "";
    position: absolute;
    top: -1.5rem;
    left: 25%;
    width: 50%;
    height: 1.5rem;
    border-top: 2px solid var(--connector);
    border-left: 2px solid var(--connector);
    border-right: 2px solid var(--connector);
  }
  .compiler {
    margin: 2.5rem auto 0;
    width: 65%;
    text-align: center;
    background: var(--ink);
    color: #fafafa;
    padding: 1rem;
    border-radius: 40px;
    position: relative;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .compiler:before {
    content: "";
    position: absolute;
    height: 2.5rem;
    top: -2.5rem;
    left: 50%;
    border-left: 2px solid var(--connector);
  }
  .compiler span {
    display: block;
    font-size: 0.7rem;
    font-weight: 400;
    color: #d4d4d4;
  }
  .outputs {
    display: flex;
    justify-content: space-between;
    text-align: center;
    margin-top: 2rem;
    gap: 0.5rem;
    border-top: 2px solid var(--connector);
    padding-top: 1rem;
  }
  .outputs strong {
    font-size: 1.05rem;
    flex: 1;
  }
  .outputs small {
    display: block;
    font-size: 0.68rem;
    font-weight: 400;
    margin-top: 0.4rem;
  }
  .thesis,
  .workflow,
  .principles {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    padding: 4rem 0;
    border-top: 1px solid var(--line);
  }
  .thesis p:first-child,
  .workflow p:first-of-type {
    margin-top: 0;
  }
  .workflow h2 {
    margin-bottom: 1.5rem;
  }
  .terminal {
    background: var(--mist);
    padding: 1.5rem;
    border-radius: 8px;
    min-width: 0;
  }
  .terminal pre {
    margin: 0;
    overflow: auto;
    line-height: 1.8;
  }
  .terminal p {
    font-size: 0.75rem;
    margin-bottom: 0;
    color: #525252;
  }
  .commands {
    padding: 3rem 0 4rem;
  }
  .commands h2 {
    margin-bottom: 2rem;
  }
  dl > div {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    gap: 2rem;
  }
  dt {
    color: var(--accent);
    font-weight: 600;
  }
  dd {
    margin: 0;
    line-height: 1.5;
  }
  .principles p {
    margin-bottom: 2rem;
  }
  .experimental {
    border-left: 4px solid var(--connector);
    padding: 1rem 2rem;
    background: var(--mist);
    margin: 1rem 0 5rem;
  }
  .experimental p {
    margin-bottom: 0;
    font-size: 0.95rem;
    max-width: 65rem;
  }
  footer {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
    padding-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    font-size: 0.8rem;
  }
  footer p {
    flex: 1;
  }
  .skip {
    position: absolute;
    top: -100px;
    padding: 1rem;
    background: #fafafa;
  }
  .skip:focus {
    top: 0;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2rem;
    }
    .map {
      max-width: 540px;
      width: 100%;
      margin: auto;
    }
    .thesis,
    .workflow,
    .principles {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 0;
    }
    h1 {
      font-size: 4rem;
    }
    footer {
      flex-wrap: wrap;
    }
    footer p {
      flex: auto;
    }
    nav {
      gap: 1rem;
    }
  }
  @media (max-width: 550px) {
    .masthead {
      align-items: center;
      gap: 1rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }
    nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      font-size: 0.8rem;
      gap: 0.5rem 1rem;
    }
    .masthead nav a:nth-child(n + 3) {
      display: none;
    }
    h1 {
      font-size: clamp(2.25rem, 10.5vw, 3rem);
      letter-spacing: -0.055em;
      line-height: 1.08;
      margin: 1rem 0;
    }
    .hero {
      padding-top: 1.25rem;
      padding-bottom: 2rem;
      gap: 1rem;
    }
    .release {
      margin: 0;
      font-size: 0.75rem;
    }
    .lead {
      font-size: 1rem;
    }
    .promise {
      font-size: 0.8rem;
    }
    .map {
      padding: 1rem 0;
    }
    .terminal {
      padding: 1rem;
    }
    .terminal pre {
      font-size: 0.8rem;
    }
    .thesis,
    .workflow,
    .principles {
      padding: 2.5rem 0;
      gap: 1.5rem;
    }
    dl > div {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .file {
      padding: 0.8rem;
    }
    .branch {
      gap: 0.6rem;
    }
    .experimental {
      padding: 1rem;
    }
    .outputs small {
      font-size: 0.62rem;
    }
  }
</style>
