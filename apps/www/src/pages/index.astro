---
import packageJson from "../../package.json";
import "../styles/andersseen.css";

const version = packageJson.version;
const repository = "https://github.com/Andersseen/Entwine";
const steps = [
  [
    "init",
    "Scaffold the recommended project knowledge. Questions, not answers.",
  ],
  ["dev", "Read it locally. Rebuilds when Markdown changes."],
  [
    "check",
    "Validate links and metadata, and see which knowledge areas exist.",
  ],
  ["setup", "Automate validation and publishing with your Git provider."],
] as const;
const providers = [
  ["GitHub", "GitHub Pages"],
  ["GitLab", "GitLab Pages"],
  ["Bitbucket", "Provider-native static publishing"],
  ["Any Git", "dist/ on any static host"],
] as const;
---

<!doctype html>
<html lang="en" and-mode="light" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Entwine turns repository Markdown into static documentation, relationships, backlinks, a graph, validation, and structured context."
    />
    <title>Entwine — project knowledge, connected.</title>
    <link rel="canonical" href="https://entwine.andersseen.dev/" />
    <meta
      property="og:title"
      content="Entwine — Project knowledge, connected."
    />
    <meta
      property="og:description"
      content="One source of project knowledge, for humans and agents. Markdown → Docs + Graph + Context."
    />
    <meta property="og:url" content="https://entwine.andersseen.dev/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://entwine.andersseen.dev/logo.png"
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header
      class="masthead"
      and-layout="horizontal align:center justify:between wrap:wrap gap:md"
    >
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a>
        <a href="/demo/">Live example</a>
        <a href="#convention">Convention</a>
        <a href="#integrate">For agents</a>
        <a href="#start">Start here</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero">
        <div class="intro">
          <p class="release">Open source / Experimental {version}</p>
          <h1>
            Project knowledge,
            <br />
            connected.
          </h1>
          <p class="lead">
            Turn the Markdown in your repository into navigable documentation,
            an interactive knowledge graph, backlinks, validation, and
            structured context. Optionally model agent instructions and skills
            alongside your docs.
          </p>
          <p class="actions">
            <a class="button" href="#start">
              Get started
            </a>
            <a class="button secondary" href="/demo/">
              Live demo → documentation
            </a>
            <a class="button secondary" href="/demo/__entwine/graph/">
              Explore the graph
            </a>
            <a class="button secondary" href="/demo/__entwine/agents/">
              See agent knowledge
            </a>
            <a class="button secondary" href="/demo/__entwine/knowledge/">
              Knowledge → coverage
            </a>
          </p>
          <p class="promise">
            Both sites are generated by Entwine from plain Markdown. Your
            Markdown remains the source of truth.
          </p>
        </div>
        <div
          class="map"
          aria-label="Markdown files connect into documentation, graph, and context"
        >
          <div class="file root">
            <span>docs/</span>
            <strong>index.md</strong>
            <small>Your project starts here.</small>
          </div>
          <div class="branch">
            <div class="file">
              <span>docs/</span>
              <strong>architecture.md</strong>
              <small>Decisions become connections.</small>
            </div>
            <div class="file">
              <span>docs/specs/</span>
              <strong>search.md</strong>
              <small>Links carry the relationships.</small>
            </div>
          </div>
          <div class="compiler">
            Entwine<span>One knowledge model</span>
          </div>
          <div class="outputs">
            <strong>
              Docs<small>Read &amp; navigate</small>
            </strong>
            <strong>
              Graph<small>Follow connections</small>
            </strong>
            <strong>
              Context<small>Reuse knowledge</small>
            </strong>
          </div>
        </div>
      </section>
      <section class="thesis" id="how">
        <h2>Project knowledge is fragmented.</h2>
        <div>
          <p>
            It is spread across the README, docs, architecture notes, state
            files, decisions, specifications, and agent context. The connections
            between them disappear, and every newcomer, human or agent,
            reconstructs the same facts again.
          </p>
          <p>
            Entwine follows the links you already write and turns the Markdown
            in your repository into one shared model of that knowledge.
          </p>
          <pre
            tabindex="0"
            class="flow"
            aria-label="Markdown becomes a knowledge model that feeds docs, graph, and context"
          ><code>Markdown
   ↓
Knowledge model
   ↓
Docs + Graph + Context</code></pre>
        </div>
      </section>
      <section class="thesis" id="convention">
        <div>
          <h2>A convention for durable project knowledge.</h2>
          <p class="note">
            <strong>Recommended, not required.</strong> Any Markdown still
            works. Custom filenames work too: a <code>type</code> in frontmatter
            is enough.
          </p>
        </div>
        <div>
          <pre class="tree" tabindex="0"><code>docs/
├── index.md          what this is, where things are
├── architecture.md   how it is structured today
├── state.md          what is true right now
├── roadmap.md        what is intended next
├── decisions/        what was decided, and why
└── specs/            what capabilities do</code></pre>
          <p>
            <code>state</code> is current reality; <code>roadmap</code> is
            future intent. Entwine recognizes each by path or metadata and shows
            which areas exist: presence, never a quality score. It complements{" "}
            <code>README.md</code>, <code>AGENTS.md</code>,<code>SKILL.md</code>
            , MCP, and OpenSpec instead of replacing them.
            <a href="/docs/convention/">Read the convention</a>.
          </p>
        </div>
      </section>
      <section class="thesis" id="agents">
        <h2>Humans and agents share one source.</h2>
        <div>
          <p>
            The same Markdown feeds readable documentation with backlinks, a
            project graph, and a Knowledge overview for people, and structured
            context for agents. A tool can ask for the current state or the
            architecture directly instead of guessing which file to open.
          </p>
          <p>
            <code>entwine context --json</code> labels every document with its
            role: architecture, state, roadmap, decision, spec, or other. There
            is no second parser, and no AI inside Entwine.
          </p>
          <p>
            Repository knowledge goes beyond <code>docs/</code>. With a small,
            optional <code>entwine.toml</code>, Entwine discovers
            <code>AGENTS.md</code>, <code>CLAUDE.md</code>,
            <code>GEMINI.md</code>, and <code>SKILL.md</code>, models their
            scope, skill folders, and links to your documentation, and shows
            them in the graph and an
            <a href="/demo/__entwine/agents/">Agents view</a>. Discovery is
            separate from publication: by default these files appear in context
            only, never on the public site. Entwine reads and structures them;
            it does not run them.
          </p>
          <p>
            See it in the <a href="/demo/">demo project</a>: its
            <a href="/demo/__entwine/knowledge/">Knowledge overview</a> shows
            what exists, and its <a href="/demo/__entwine/graph/">graph</a>
            shows how it connects.
          </p>
        </div>
      </section>
      <section class="integrate" id="integrate">
        <h2>Plug Entwine into your coding agent.</h2>
        <p class="lead">
          Coding agents guess which file to open. Entwine gives them the
          structure instead: roles, relationships, validation, and the documents
          themselves, all read from the Markdown you already maintain. Three
          pieces, each optional, each published on npm or installed from this
          repository.
        </p>
        <ul class="pieces" and-layout="grid cols:1 cols@md:3 gap:lg">
          <li class="piece" and-motion="fade-in-up" and-motion-duration="420ms">
            <span and-icon="terminal" aria-hidden="true"></span>
            <h3>CLI</h3>
            <p and-text="p-sm">
              The compiler and documentation workflow: <code>init</code>,
              <code>check</code>, <code>build</code>, <code>setup</code>, and
              <code>context --json</code>.
            </p>
            <a
              class="pkg"
              href="https://www.npmjs.com/package/@entwine/cli"
              rel="noopener"
            >
              <code>@entwine/cli</code>
              <span and-icon="external-link" aria-hidden="true"></span>
              <span class="sr-only">on npm</span>
            </a>
          </li>
          <li
            class="piece"
            and-motion="fade-in-up"
            and-motion-duration="420ms"
            and-motion-delay="80ms"
          >
            <span and-icon="book-open" aria-hidden="true"></span>
            <h3>Skills</h3>
            <p and-text="p-sm">
              Instructions an agent loads on demand: get started, maintain
              knowledge, publish. Installed with the <code>skills</code> CLI,
              from this repository.
            </p>
            <a
              class="pkg"
              href="https://www.npmjs.com/package/skills"
              rel="noopener"
            >
              <code>skills</code>
              <span and-icon="external-link" aria-hidden="true"></span>
              <span class="sr-only">installer on npm</span>
            </a>
          </li>
          <li
            class="piece"
            and-motion="fade-in-up"
            and-motion-duration="420ms"
            and-motion-delay="160ms"
          >
            <span and-icon="layers" aria-hidden="true"></span>
            <h3>MCP server</h3>
            <p and-text="p-sm">
              A read-only project knowledge server over stdio. Documents,
              relationships and validation, addressed by ids, never by path.
            </p>
            <a
              class="pkg"
              href="https://www.npmjs.com/package/@entwine/mcp"
              rel="noopener"
            >
              <code>@entwine/mcp</code>
              <span and-icon="external-link" aria-hidden="true"></span>
              <span class="sr-only">on npm</span>
            </a>
          </li>
        </ul>
        <p class="compat">
          <and-badge>{version}</and-badge>
          <span>
            <code>@entwine/mcp</code> depends on the exact same version of
            <code>@entwine/cli</code>, so the pair cannot drift apart.
          </span>
        </p>

        <h3 class="step-title">
          <span>1</span> Install the skills
        </h3>
        <div class="snippet">
          <pre tabindex="0"><code id="cmd-skills">npx skills add https://github.com/Andersseen/Entwine/tree/main/skills --agent codex claude-code --copy -y</code></pre>
          <button
            type="button"
            class="copy"
            data-copy-target="cmd-skills"
            data-copy-name="skills install command"
            hidden
          >
            <span and-icon="copy" aria-hidden="true"></span>
            <span class="copy-label">Copy</span>
            <span class="sr-only">skills install command</span>
          </button>
        </div>

        <h3 class="step-title">
          <span>2</span> Register the MCP server
        </h3>
        <and-tabs default-value="codex" class="tabs">
          <and-tabs-list>
            <and-tabs-trigger value="codex">Codex</and-tabs-trigger>
            <and-tabs-trigger value="claude">Claude Code</and-tabs-trigger>
          </and-tabs-list>
          <and-tabs-content value="codex" data-label="Codex">
            <div class="snippet">
              <pre tabindex="0"><code id="cmd-codex">codex mcp add entwine -- npx --yes @entwine/mcp --root .</code></pre>
              <button
                type="button"
                class="copy"
                data-copy-target="cmd-codex"
                data-copy-name="Codex command"
                hidden
              >
                <span and-icon="copy" aria-hidden="true"></span>
                <span class="copy-label">Copy</span>
                <span class="sr-only">Codex command</span>
              </button>
            </div>
          </and-tabs-content>
          <and-tabs-content value="claude" data-label="Claude Code">
            <div class="snippet">
              <pre tabindex="0"><code id="cmd-claude">claude mcp add entwine --scope project -- npx --yes @entwine/mcp --root .</code></pre>
              <button
                type="button"
                class="copy"
                data-copy-target="cmd-claude"
                data-copy-name="Claude Code command"
                hidden
              >
                <span and-icon="copy" aria-hidden="true"></span>
                <span class="copy-label">Copy</span>
                <span class="sr-only">Claude Code command</span>
              </button>
            </div>
          </and-tabs-content>
        </and-tabs>
        <p class="hint">
          The CLI is bundled with the MCP package, so there is nothing else to
          install. Use <code>npm install --global @entwine/cli</code> to run
          <code>entwine</code> yourself.
        </p>

        <h3 class="step-title">
          <span>3</span> Ask
        </h3>
        <figure
          class="transcript"
          and-motion="fade-in-up"
          and-motion-duration="420ms"
        >
          <figcaption>Illustrative session</figcaption>
          <p class="you">
            <strong>You</strong>
            <span>Use Entwine to give me a project overview.</span>
          </p>
          <p class="agent">
            <strong>Agent</strong>
            <span>
              Calls <code>entwine_project_overview</code>, then
              <code>entwine_read_document</code> for <code>state.md</code> and
              <code>architecture.md</code>, and answers from those documents. It
              never receives a file path, and nothing is written.
            </span>
          </p>
        </figure>

        <div class="more">
          <details>
            <summary>
              The server does not start{" "}
              <span and-icon="chevron-down" aria-hidden="true"></span>
            </summary>
            <div class="detail">
              <p>
                <code>@entwine/mcp</code> needs Node 20 or newer. Run
                <code>npx --yes @entwine/mcp --version</code>: it prints its
                version and the context schema it supports. To reproduce a setup
                exactly, pin the version:
                <code>npx --yes @entwine/mcp@{version} --root .</code>.
              </p>
            </div>
          </details>
          <details>
            <summary>
              Which agent files become public?{" "}
              <span and-icon="chevron-down" aria-hidden="true"></span>
            </summary>
            <div class="detail">
              <p>
                None by default. Discovery only feeds local context and the MCP
                server. To publish a few skills, name them in
                <code>site.public_agent_paths</code>; internal
                <code>AGENTS.md</code> files stay private. This option is in the
                source tree and ships with the next CLI release.
              </p>
            </div>
          </details>
        </div>
        <p>
          Applying <code>init</code> or <code>setup</code> stays the agent
          running the CLI under your normal approval.
          <a href="/docs/agent-integration/">Read the integration guide</a>
          for Windows paths, config files, and verification.
        </p>
        <p
          id="copy-status"
          class="sr-only"
          role="status"
          aria-live="polite"
        ></p>
      </section>
      <section class="workflow" id="start">
        <div>
          <h2>Start here.</h2>
          <p>
            No account, documentation app, or configuration file required;
            <code>entwine.toml</code> is optional and only needed for agent
            knowledge. <code>entwine build</code> remains available for any
            custom hosting.
          </p>
          <p>
            Install Entwine {version} from npm, or download a native binary for
            Linux x86_64, macOS arm64/x86_64, or Windows x86_64 from
            <a href={`${repository}/releases`}>GitHub Releases</a>. Verify
            native archives against the release’s SHA256SUMS. Binaries are
            unsigned; Entwine remains pre-1.0.
          </p>
          <dl class="steps">
            {steps.map(([command, description]) => (
              <div>
                <dt>
                  <code>entwine {command}</code>
                </dt>
                <dd>{description}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="terminal">
          <pre><code># Install the native CLI through npm
npm install --global @entwine/cli

# In your own repository
entwine init
entwine dev
entwine check
entwine setup

# Or publish dist/ yourself
entwine build</code></pre>
          <p>Local preview at localhost:4173. Refresh after edits.</p>
        </div>
      </section>
      <section class="commands" id="deployment">
        <h2>Publish where your repository lives.</h2>
        <p class="lead">
          <code>entwine setup</code> generates validation and publishing for
          your Git provider, once. After that, the provider's own pipeline
          publishes. Entwine is not a hosted platform and stores no credentials.
        </p>
        <dl>
          {providers.map(([provider, target]) => (
            <div>
              <dt>{provider}</dt>
              <dd>{target}</dd>
            </div>
          ))}
        </dl>
        <p>
          Documentation changes in a pull request are validated before merge.
          Existing CI is never overwritten, and
          <code>entwine setup --dry-run</code> changes nothing.
          <a href="/docs/deployment/">Deployment details</a>, including
          Bitbucket's one-time steps.
        </p>
      </section>
      <section class="principles">
        <h2>
          Small by design.
          <br />
          Clear at the boundaries.
        </h2>
        <div>
          <h3>Parse once, project many ways</h3>
          <p>
            A Rust engine compiles Markdown into one canonical knowledge model.
            Site, graph, and context all derive from it. The renderer is not the
            knowledge model.
          </p>
          <h3>Repository-native and stack-agnostic</h3>
          <p>
            Your application can use any language or framework. Generated
            documentation is static HTML and CSS, with no Entwine runtime in
            production.
          </p>
          <h3>Predictable, inspectable output</h3>
          <p>
            File-based routes. Stable ordering. Automatically derived backlinks.
            A graph that is static SVG first, with an optional small script for
            pan, zoom, drag, filters, and focus. Markdown or JSON context. No AI
            inference or network requests during builds.
          </p>
        </div>
      </section>
      <aside class="experimental">
        <strong>Experimental and pre-1.0.</strong>
        <p>
          Entwine {version} is experimental and pre-stable. APIs and the context
          schema may change before 1.0. There is no search, plugin system, or
          hosted service. The graph’s interactivity is a small script on a
          static page. The Knowledge Convention is an open proposal that has to
          earn adoption, not a standard.
        </p>
      </aside>
    </main>
    <footer>
      <a class="wordmark" href="#">
        <img src="/logo.png" alt="" width="36" height="36" />
        entwine
      </a>
      <p>Project knowledge, connected.</p>
      <a href={repository}>GitHub</a>
      <a href="/docs/">Documentation</a>
      <a href="/demo/">Example</a>
      <a href="/docs/agent-integration/">Agents</a>
      <span>MIT licensed</span>
    </footer>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>

<style>
  :root {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    color: #171717;
    background: #f5f5f5;
    font-synthesis: none;
    --ink: #171717;
    --accent: #404040;
    --line: #d4d4d4;
    --mist: #e5e5e5;
    --connector: #737373;
  }
  * {
    box-sizing: border-box;
  }
  .hero > *,
  .thesis > *,
  .workflow > *,
  .principles > *,
  dl > div > * {
    min-width: 0;
  }
  h1,
  h2,
  p,
  dd {
    overflow-wrap: anywhere;
  }
  body {
    margin: 0;
  }
  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: 3px solid var(--connector);
    outline-offset: 5px;
  }
  p {
    line-height: 1.7;
  }
  code {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .masthead,
  main,
  footer {
    max-width: 1280px;
    margin: auto;
    padding-left: clamp(1.5rem, 5vw, 5rem);
    padding-right: clamp(1.5rem, 5vw, 5rem);
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }
  .wordmark img {
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }
  nav a {
    text-decoration: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 4rem 0 6rem;
  }
  .release {
    font-size: 0.85rem;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    line-height: 1.03;
    letter-spacing: -0.065em;
    font-weight: 650;
    margin: 1.5rem 0;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .lead {
    font-size: 1.16rem;
    max-width: 36rem;
  }
  .button {
    display: inline-block;
    background: var(--accent);
    color: #fafafa;
    text-decoration: none;
    border-radius: 6px;
    padding: 0.9rem 1.3rem;
    margin-top: 0.8rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
  }
  .actions .button {
    margin-top: 0;
  }
  .button.secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--accent);
    padding: calc(0.9rem - 1px) calc(1.3rem - 1px);
  }
  .promise {
    font-size: 0.85rem;
    color: #525252;
  }
  .map {
    position: relative;
    padding: 1.5rem 0;
  }
  .file {
    background: #fafafa;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.2rem;
    box-shadow: 0 6px 0 var(--mist);
    min-width: 0;
  }
  .file span,
  .file small {
    display: block;
    font-size: 0.72rem;
    color: #525252;
  }
  .file strong {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    margin: 0.4rem 0;
    overflow-wrap: anywhere;
  }
  .root {
    width: 65%;
    margin: 0 auto;
  }
  .branch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    position: relative;
  }
  .branch:before {
    content: "";
    position: absolute;
    top: -1.5rem;
    left: 25%;
    width: 50%;
    height: 1.5rem;
    border-top: 2px solid var(--connector);
    border-left: 2px solid var(--connector);
    border-right: 2px solid var(--connector);
  }
  .compiler {
    margin: 2.5rem auto 0;
    width: 65%;
    text-align: center;
    background: var(--ink);
    color: #fafafa;
    padding: 1rem;
    border-radius: 40px;
    position: relative;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .compiler:before {
